# Render will provide PORT automatically. Keep this as 5000 for local development.
PORT=5000
NODE_ENV=production

# Render PostgreSQL Internal Database URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate long random values. Do NOT use these example values in production.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Exact GitHub Pages frontend origin
FRONTEND_URL=https://sonainfo.github.io

# Upload configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d

# Optional seed admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
SEED_ADMIN_NAME=Sonainfo Admin
SEED_ADMIN_ROLE=admin
